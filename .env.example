# Database (SQLite local — sin servicios externos)
# El esquema define la ruta real: file:../data/corelyze.sqlite
DATABASE_URL="file:../data/corelyze.sqlite"

# Backend API
BACKEND_PORT=3000
API_PREFIX=api
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRATION=24h

# Environment
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Agent (Tauri)
TAURI_DEV_HOST=localhost
TAURI_DEV_PORT=1420

# API Endpoint for Agent
API_ENDPOINT=http://localhost:3000/api

# Sincronización remota del catálogo (OPCIONAL). Si está vacío, la app usa
# únicamente la base local SQLite (modo offline, sin errores ni bloqueos).
# Ejemplo: CATALOG_SYNC_URL=https://cdn.tu-dominio.com/corelyze/catalogo.json
CATALOG_SYNC_URL=
CATALOG_SYNC_TIMEOUT_MS=5000
