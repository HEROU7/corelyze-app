{
  "name": "corelyze",
  "version": "1.0.0",
  "description": "Plataforma comercial multiplataforma de diagnóstico, simulación, gestión de compatibilidad y recomendación de hardware de PC",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=apps/backend",
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "dev:agent": "npm run dev --workspace=apps/agent",
    "build:agent": "npm run build --workspace=apps/agent",
    "tauri:build": "npx @tauri-apps/cli build",
    "db:generate": "npm run db:generate --workspace=apps/backend",
    "db:migrate": "npm run db:migrate --workspace=apps/backend",
    "db:deploy": "npm run db:deploy --workspace=apps/backend",
    "db:seed": "npm run db:seed --workspace=apps/backend",
    "db:studio": "npm run db:studio --workspace=apps/backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}